{
  "$schema": "../../docs/plugin-system/api/manifest.schema.json",
  "id": "linplayer/debug-panel",
  "name": "调试面板",
  "version": "0.1.0",
  "description": "官方调试面板:插件运行时状态、最近日志与网络请求、UI 渲染器的示例页。它同时是 UI 渲染器的第一个真实用户 —— 渲染器坏了这一页先坏。",
  "minAppVersion": "1.1.0",
  "license": "AGPL-3.0",
  "activation": { "load": "lazy", "lifetime": "idle" },
  "contributes": {
    "pages": [
      { "id": "panel", "title": "调试面板" },
      { "id": "gallery", "title": "组件示例页" }
    ],
    "sidebar": [
      { "id": "debug", "title": "调试面板", "page": "panel" }
    ]
  },
  "main": "dist/main.js"
}
