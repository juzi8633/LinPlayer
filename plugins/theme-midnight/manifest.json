{
  "$schema": "../../docs/plugin-system/api/manifest.schema.json",
  "id": "linplayer/theme-midnight",
  "name": "午夜蓝(桌面)",
  "version": "0.1.0",
  "description": "官方示范主题:更深的蓝底、更亮的强调色。示范一个主题包能改什么 —— 设计 token 与组件状态样式,结构和行为不变。",
  "minAppVersion": "2.0.0",
  "license": "AGPL-3.0",
  "platforms": ["windows", "linux"],
  "activation": { "load": "lazy", "lifetime": "idle" },
  "contributes": {
    "theme": { "platform": "desktop", "axaml": ["theme/midnight.axaml"], "modes": ["dark", "light"] }
  },
  "main": "main.js"
}
